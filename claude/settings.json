{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "tui": "default",
  "autoScrollEnabled": true,
  "model": "claude-opus-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/ado-pr-title-check.py\"",
            "timeout": 10,
            "statusMessage": "Checking PR title format..."
          }
        ]
      }
    ]
  }
}
